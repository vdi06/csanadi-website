{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdi06.github.io/csanadi-website/json/schemas/social.schema.json",
  "title": "Csanádi Sportiskola – social",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "status",
    "lastChecked",
    "description",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "collectionId": {
      "const": "collection:social-2026"
    },
    "status": {
      "enum": [
        "development",
        "published"
      ]
    },
    "lastChecked": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "platform",
          "label",
          "url",
          "status",
          "schoolVerified",
          "icon",
          "embed"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^social:[a-z0-9-]+$"
          },
          "platform": {
            "enum": [
              "Facebook",
              "Instagram",
              "YouTube",
              "TikTok",
              "LinkedIn"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "url": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^https://[^ ]+$"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "external-directory-listed",
              "pending-verification",
              "published"
            ]
          },
          "schoolVerified": {
            "type": "boolean"
          },
          "icon": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "embed": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "approved",
              "url"
            ],
            "properties": {
              "approved": {
                "type": "boolean"
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^https://[^ ]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "approved": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "url": {
                      "type": "string",
                      "pattern": "^https://[^ ]+$"
                    }
                  }
                }
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              }
            },
            "then": {
              "properties": {
                "schoolVerified": {
                  "const": true
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://[^ ]+$"
                }
              }
            }
          }
        ]
      }
    }
  }
}
