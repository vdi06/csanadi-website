{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdi06.github.io/csanadi-website/json/schemas/csengetesi-rend.schema.json",
  "title": "Csanádi Sportiskola – csengetesi-rend",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "status",
    "verifiedBySchool",
    "timezone",
    "schoolYear",
    "description",
    "applicableWeekdays",
    "defaultScheduleId",
    "revision",
    "schedules",
    "specialDates"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "collectionId": {
      "const": "collection:csengetesi-rend"
    },
    "status": {
      "enum": [
        "preview",
        "verified"
      ]
    },
    "verifiedBySchool": {
      "type": "boolean"
    },
    "timezone": {
      "const": "Europe/Budapest"
    },
    "schoolYear": {
      "type": "string",
      "pattern": "^\\d{4}/\\d{4}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "applicableWeekdays": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 6
      }
    },
    "defaultScheduleId": {
      "type": "string",
      "pattern": "^[a-z]+:[a-z0-9-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "schedules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "status",
          "periods"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^schedule:[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "status": {
            "enum": [
              "preview",
              "verified"
            ]
          },
          "periods": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "number",
                "start",
                "end"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z]+:[a-z0-9-]+$"
                },
                "number": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 30
                },
                "start": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                },
                "end": {
                  "type": "string",
                  "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$"
                }
              }
            }
          }
        }
      }
    },
    "specialDates": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "date",
          "kind",
          "verified"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "kind": {
            "enum": [
              "no-school",
              "schedule"
            ]
          },
          "scheduleId": {
            "type": "string",
            "pattern": "^[a-z]+:[a-z0-9-]+$"
          },
          "verified": {
            "const": true
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "schedule"
                }
              }
            },
            "then": {
              "required": [
                "scheduleId"
              ]
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "properties": {
          "verifiedBySchool": {
            "const": true
          }
        }
      }
    }
  ]
}
