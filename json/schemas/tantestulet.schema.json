{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdi06.github.io/csanadi-website/json/schemas/tantestulet.schema.json",
  "title": "Csanádi Sportiskola – tantestulet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "title",
    "revision",
    "status",
    "privacy",
    "description",
    "staff",
    "teams"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "collectionId": {
      "const": "collection:tantestulet"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "development",
        "published"
      ]
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publishOnlyApproved",
        "publicPrivateContacts",
        "consentRequiredForPortraits"
      ],
      "properties": {
        "publishOnlyApproved": {
          "const": true
        },
        "publicPrivateContacts": {
          "const": false
        },
        "consentRequiredForPortraits": {
          "const": true
        }
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "staff": {
      "type": "array",
      "maxItems": 400,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fullName",
          "role",
          "teamIds",
          "subjects",
          "bio",
          "status",
          "publicApproved",
          "portraitApproved"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^staff:[a-z0-9-]+$"
          },
          "fullName": {
            "type": "string",
            "minLength": 5,
            "maxLength": 150
          },
          "role": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "teamIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z]+:[a-z0-9-]+$"
            }
          },
          "subjects": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "bio": {
            "type": "string",
            "minLength": 30,
            "maxLength": 3000
          },
          "status": {
            "const": "published"
          },
          "publicApproved": {
            "const": true
          },
          "portrait": {
            "type": "string",
            "pattern": "^assets/media/staff/[a-z0-9-]+\\.webp$"
          },
          "portraitApproved": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "portrait"
              ]
            },
            "then": {
              "properties": {
                "portraitApproved": {
                  "const": true
                }
              }
            }
          }
        ]
      }
    },
    "teams": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "category",
          "verifiedInstitutionalUnit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^team:[a-z0-9-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "category": {
            "enum": [
              "oktatas",
              "sport",
              "kozosseg"
            ]
          },
          "verifiedInstitutionalUnit": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
