{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdi06.github.io/csanadi-website/json/schemas/esemenyek.schema.json",
  "title": "Csanádi Sportiskola – esemenyek",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "timezone",
    "refreshSeconds",
    "description",
    "categories",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": "2.0.0"
    },
    "collectionId": {
      "const": "collection:esemenyek"
    },
    "timezone": {
      "const": "Europe/Budapest"
    },
    "refreshSeconds": {
      "type": "integer",
      "minimum": 15,
      "maximum": 3600
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z]+:[a-z0-9-]+$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        }
      }
    },
    "items": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "categoryId",
          "status",
          "startsAt",
          "endsAt",
          "location",
          "route",
          "source",
          "priority"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^esemeny:[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 8,
            "maxLength": 140
          },
          "summary": {
            "type": "string",
            "minLength": 30,
            "maxLength": 500
          },
          "categoryId": {
            "type": "string",
            "pattern": "^[a-z]+:[a-z0-9-]+$"
          },
          "status": {
            "enum": [
              "preview",
              "published"
            ]
          },
          "startsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "endsAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "route": {
            "type": "string",
            "pattern": "^#/[a-z0-9/-]+$"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "verified"
            ],
            "properties": {
              "verified": {
                "type": "boolean"
              },
              "reference": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^https://[^ ]+$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "verifiedAt": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "preview"
                }
              }
            },
            "then": {
              "properties": {
                "startsAt": {
                  "type": "null"
                },
                "endsAt": {
                  "type": "null"
                },
                "source": {
                  "properties": {
                    "verified": {
                      "const": false
                    }
                  }
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "published"
                }
              }
            },
            "then": {
              "properties": {
                "startsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "endsAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "source": {
                  "properties": {
                    "verified": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        ]
      }
    }
  }
}
