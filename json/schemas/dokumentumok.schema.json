{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vdi06.github.io/csanadi-website/json/schemas/dokumentumok.schema.json",
  "title": "Csanádi 2026 – publikus dokumentumadatbázis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionId",
    "locale",
    "updatedAt",
    "description",
    "defaultView",
    "defaultSort",
    "refreshSeconds",
    "categories",
    "documents"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "collectionId": {
      "const": "collection:csanadi-public-documents"
    },
    "locale": {
      "const": "hu-HU"
    },
    "updatedAt": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 20
    },
    "defaultView": {
      "enum": [
        "cards",
        "list",
        "table"
      ]
    },
    "defaultSort": {
      "enum": [
        "newest",
        "oldest",
        "title",
        "size"
      ]
    },
    "refreshSeconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "parentId",
          "description",
          "order"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{2,80}$"
          },
          "label": {
            "type": "string",
            "minLength": 3
          },
          "parentId": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 5
          },
          "order": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "summary",
          "categoryId",
          "tags",
          "keywords",
          "status",
          "documentKind",
          "mimeType",
          "fileName",
          "filePath",
          "fileSizeBytes",
          "sha256",
          "version",
          "publishedAt",
          "validFrom",
          "validTo",
          "relatedRoutes",
          "official",
          "versionHistory"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^document:[a-z0-9-]+$"
          },
          "title": {
            "type": "string",
            "minLength": 5
          },
          "summary": {
            "type": "string",
            "minLength": 20
          },
          "categoryId": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "keywords": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "status": {
            "enum": [
              "published",
              "archived",
              "withdrawn"
            ]
          },
          "documentKind": {
            "enum": [
              "guide",
              "form",
              "policy",
              "publication",
              "other"
            ]
          },
          "mimeType": {
            "enum": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
              "text/plain"
            ]
          },
          "fileName": {
            "type": "string",
            "minLength": 5
          },
          "filePath": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^assets/documents/[a-z0-9-]+\\.(pdf|docx|txt)$"
          },
          "fileSizeBytes": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "sha256": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9a-f]{64}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "publishedAt": {
            "type": "string",
            "format": "date"
          },
          "validFrom": {
            "type": "string",
            "format": "date"
          },
          "validTo": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "relatedRoutes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^#/[a-z0-9/-]*$"
            },
            "uniqueItems": true
          },
          "official": {
            "type": "boolean"
          },
          "versionHistory": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "version",
                "date",
                "change"
              ],
              "properties": {
                "version": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "date": {
                  "type": "string",
                  "format": "date"
                },
                "change": {
                  "type": "string",
                  "minLength": 5
                }
              }
            }
          }
        }
      }
    }
  }
}
