    {
      "id": "block:home-editorial-2026",
      "type": "home-editorial",
      "title": "A teljesítmény mögött emberek vannak",
      "data": {
        "eyebrow": "TÖBB MINT EGY WEBOLDAL",
        "lead": "A sportolói fejlődés nem egyetlen mérkőzésen vagy versenyen dől el. Az iskolai felkészülés, a közös munka, a tanulás és a tapasztalatok egymásra épülnek. Ebben a szemléletben mutatjuk be az oktatás és a sport találkozását.",
        "items": [
          {
            "icon": "trophy",
            "title": "Sport – kitartás és együttműködés",
            "text": "Egy sportág megtanít célokat kitűzni, figyelni a részletekre és tovább dolgozni egy nehezebb nap után is. A csapatsportok az együttműködést, az egyéni sportágak az önismeretet és a tudatos felkészülést erősíthetik. A sportoldalak sportáganként összekapcsolják a történeteket, a képeket és az eredményeket.",
            "href": "#/sport/sportagak",
            "linkText": "Sportágak megtekintése"
          },
          {
            "icon": "study",
            "title": "Oktatás – tudás és kíváncsiság",
            "text": "A tanulás a kérdezéssel, a gyakorlással és a megértés keresésével válik igazán élővé. Az oktatási központban helyet kapnak a képzési területek, a felvételi tájékozódást segítő anyagok, a vizsgák és a tanévi információk. A cél, hogy az eligazodás egyszerű legyen.",
            "href": "#/oktatas",
            "linkText": "Oktatási központ"
          },
          {
            "icon": "users",
            "title": "Közösség – egymásra figyelés",
            "text": "A közösségi alkalmak, a sportversenyek, az iskolai események és a mindennapi beszélgetések egyaránt meghatározó élményekké válhatnak. A honlap ezért a híreket, az eseményeket és a képeket összekapcsolva mutatja be, és lehetőséget ad arra, hogy mindenki megtalálja a számára fontos témákat.",
            "href": "#/hirek-es-esemenyek",
            "linkText": "Hírek és események"
          }
        ]
      }
